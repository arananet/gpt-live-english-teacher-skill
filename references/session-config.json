{
  "_comment": "API fallback config. GPT-Live-1 is the skill's target model but is not yet available in the API; until it is, run the Realtime API with gpt-realtime as below. When GPT-Live-1 ships in the API, retarget the session to it and drop the turn_detection tuning — full-duplex GPT-Live times its own interruptions.",
  "type": "session.update",
  "session": {
    "type": "realtime",
    "model": "gpt-realtime",
    "output_modalities": ["audio"],
    "instructions": "<paste the system prompt from references/system-prompt.md>",
    "audio": {
      "input": {
        "format": { "type": "audio/pcm", "rate": 24000 },
        "transcription": {
          "model": "gpt-4o-transcribe",
          "language": "en"
        },
        "turn_detection": {
          "type": "semantic_vad",
          "eagerness": "low",
          "create_response": true,
          "interrupt_response": true
        }
      },
      "output": {
        "format": { "type": "audio/pcm", "rate": 24000 },
        "voice": "marin",
        "speed": 1.0
      }
    }
  }
}
